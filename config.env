# Paper bot settings. Change a value here and push: the server picks it up within 10 minutes.
# Private values (Telegram) live only on the server in /opt/mkhalifa-polymarket/.env
PM_ASSETS=btc,eth
PM_START_BANKROLL=100
PM_RISK_PCT=0.03
PM_MAX_STAKE=10
PM_DAILY_STOP_PCT=0.10
PM_MIN_EDGE=0.03
PM_MIN_PRICE=0.15
PM_MAX_PRICE=0.85
PM_MIN_TAU_S=15
PM_MAX_TAU_S=870
PM_FEE_RATE=0.07
PM_BASIS_BPS=2
PM_REPORT_HOUR=9
PM_REPORT_MINUTE=1
PM_TZ=Africa/Cairo
PM_DATA_DIR=/opt/mkhalifa-polymarket/data
