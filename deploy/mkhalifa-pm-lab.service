[Unit]
Description=MKhaliFa Polymarket strategy lab (paper only, no wallet, no keys)
After=network-online.target
Wants=network-online.target

[Service]
User=pmbot
Group=pmbot
WorkingDirectory=/opt/mkhalifa-polymarket/repo
EnvironmentFile=/opt/mkhalifa-polymarket/repo/config.env
EnvironmentFile=/opt/mkhalifa-polymarket/.env
EnvironmentFile=-/opt/mkhalifa-polymarket/override.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m pmlab.runner
Restart=always
RestartSec=15
# stay small so the live bot always comes first
Nice=10
CPUQuota=20%
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mkhalifa-polymarket/data

[Install]
WantedBy=multi-user.target
